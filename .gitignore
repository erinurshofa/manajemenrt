# ==============================================================================
# .gitignore RESMI & TERAMAN (RT Gasem Raya 02)
# Melindungi kredensial rahasia, file build, temporary cache, dan artefak OS/IDE
# ==============================================================================

# 1. Kredensial & Berkas Rahasia (CRITICAL SECURITY)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
service-account*.json
*credential*.json
firebase-applet-config.json
!firebase-applet-config.example.json

# 2. Dependencies & Package Manager Caches
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# 3. Output Build & Bundles
dist/
dist-ssr/
dev-dist/
build/
out/
coverage/
*.tsbuildinfo

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. IDE, Code Editors & AI Workspace
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
.gemini/
.system_generated/
*.tmp

# 6. Sistem Operasi (Windows, macOS, Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 7. Backup & Database Dumps Lokal
*.bak
*.backup
*.dump
*.sql.gz
*.sql.bak
*.orig
*~
